# Copy to .env.local for development, and set the same values in the hosting
# provider's environment for production.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the bundle at BUILD time,
# not read at runtime. Setting one in your host's dashboard does nothing until
# you redeploy. If a value looks like it "didn't take", that is almost always
# why.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Where the Spring backend lives.
NEXT_PUBLIC_API_URL=https://backend.mpahmapu.com

# Canonical public origin. Used for canonical URLs, the sitemap, and schema.org
# @id values. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mpahmapu.com

# Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SEO — the two that decide whether the brand surfaces on Google at all
# ─────────────────────────────────────────────────────────────────────────────

# Search Console ownership token.
#
# Until this is set and verified, the sitemap cannot be submitted and there is no
# way to ask Google to index anything or to see what it thinks the brand is.
#
# How to get it:
#   1. search.google.com/search-console
#   2. Add property -> "URL prefix" -> https://mpahmapu.com
#      (Use URL prefix, not Domain. Domain properties verify by DNS TXT record
#       and ignore the HTML tag this app renders.)
#   3. Verification method -> "HTML tag". Google shows:
#        <meta name="google-site-verification" content="AbC123...xyz" />
#   4. Copy ONLY the content value. Not the whole tag, not the quotes.
#   5. Paste below, redeploy, then press Verify in Search Console.
#   6. Once verified: Sitemaps -> submit "sitemap.xml", then URL Inspection ->
#      paste the homepage -> Request indexing.
#
# The token stays valid as long as the tag stays on the site. Removing it later
# un-verifies the property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Social profiles, comma separated, no spaces.
#
# These become schema.org sameAs, which is the strongest signal Google has for
# deciding an unfamiliar name is a real entity rather than a typo. While this is
# empty, nothing anywhere corroborates that "MpahMapu" exists, which is why a
# search for it offers results for a similarly spelled account instead.
#
# Rules that make the difference between helping and doing nothing:
#   - Only list profiles this business actually controls.
#   - Each profile should link back to mpahmapu.com from its bio/website field.
#     sameAs is a claim; the link back is what corroborates it. A profile that
#     never mentions the site is worth nothing here.
#   - Use the full canonical URL, not a handle or a shortened link.
#
# Example:
# NEXT_PUBLIC_SOCIAL_PROFILES=https://www.linkedin.com/company/mpahmapu,https://www.instagram.com/mpahmapu,https://x.com/mpahmapu,https://www.facebook.com/mpahmapu
NEXT_PUBLIC_SOCIAL_PROFILES=
