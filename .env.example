# Copy to .env.local for development, and set the same values in the hosting
# provider's environment for production.
#
# IMPORTANT: every NEXT_PUBLIC_* value is inlined into the bundle at BUILD time,
# not read at runtime. Setting one in your host's dashboard does nothing until
# you redeploy. If a value looks like it "didn't take", that is almost always
# why.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Where the Spring backend lives — SERVER-ONLY. The browser never talks to the
# backend directly: every request is routed through the same-origin gateway proxy
# at /api/g, which forwards to this URL server-side. Because this is NOT prefixed
# with NEXT_PUBLIC_, it is never inlined into the browser bundle, so the backend
# origin and the real endpoint paths stay out of the Network tab and console.
BACKEND_URL=https://backend.mpahmapu.com

# Optional shared secret the gateway stamps on every forwarded request as the
# X-Gateway-Key header. If you also configure the backend to require this header on
# /api/** (webhooks/callbacks exempt), a leaked backend URL still cannot be called
# directly — only the gateway knows the secret. Leave blank to disable.
GATEWAY_SECRET=

# DEPRECATED — do NOT set in new deployments. Superseded by BACKEND_URL above. No
# browser code references it anymore, so it is no longer shipped to the client. It
# remains only as a migration fallback for the server-side render path.
# NEXT_PUBLIC_API_URL=https://backend.mpahmapu.com

# Canonical public origin. Used for canonical URLs, the sitemap, and schema.org
# @id values. No trailing slash.
#
# MUST match the host that actually serves 200. Right now the host 308s
# https://mpahmapu.com to https://www.mpahmapu.com, so this has to say www. Point
# it at the bare domain and every page declares a canonical to a URL that
# redirects back to it, which Google discards.
NEXT_PUBLIC_SITE_URL=https://www.mpahmapu.com

# Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SEO — the two that decide whether the brand surfaces on Google at all
# ─────────────────────────────────────────────────────────────────────────────

# Search Console ownership token. OPTIONAL — and currently not needed.
#
# mpahmapu.com is already verified as a Domain property (sc-domain:mpahmapu.com),
# which is verified by DNS TXT record and covers www, non-www, http and https in
# one go. That is the better kind of property, and it makes this tag redundant:
# leave it empty.
#
# Only fill this in if you ever add a second, URL-prefix property and choose the
# "HTML tag" method. In that case Google shows:
#   <meta name="google-site-verification" content="AbC123...xyz" />
# and you copy ONLY the content value, then redeploy before pressing Verify.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Social profiles, comma separated, no spaces. OPTIONAL — leave empty.
#
# The real accounts are now hard-coded in src/lib/seo.ts, because they are public
# brand facts rather than per-environment config, and as a variable they simply
# never got set. Only fill this in to OVERRIDE them — e.g. a staging deploy that
# should not claim the live accounts.
#
# If you do set it: full canonical URLs only, profiles the business controls, and
# each one should link back to https://www.mpahmapu.com. sameAs is a claim; the
# link back is what corroborates it.
NEXT_PUBLIC_SOCIAL_PROFILES=


# ─────────────────────────────────────────────────────────────────────────────
# BazaBot AI Agent (server-side, read at RUNTIME — NOT NEXT_PUBLIC_*)
# ─────────────────────────────────────────────────────────────────────────────
# Read live inside the /api/bazabot route handlers. The default provider is Groq
# — a free, hosted, OpenAI-compatible API that runs open-source models (Llama,
# Qwen). It works on Vercel/serverless with NO local binary. Leave the key empty
# to keep BazaBot in its rule-based fallback (fully working, no model needed).

# Inference engine: groq (default, hosted) | openai-compat (any hosted OpenAI API)
#                   | ollama | llamacpp  (the last two are LOCAL DEV ONLY — they
#                   need a local server and do NOT work on Vercel).
BAZABOT_ENGINE=groq

# Chat model id. NEVER hardcoded in code — set it here. Groq examples:
#   llama-3.1-8b-instant   (fast, default)   |  llama-3.3-70b-versatile (higher quality)
#   qwen-2.5-32b           |  gemma2-9b-it
BAZABOT_MODEL=llama-3.1-8b-instant

# FREE Groq API key (no credit card): https://console.groq.com/keys
# The code also accepts BAZABOT_API_KEY for non-Groq hosted providers.
GROQ_API_KEY=
BAZABOT_API_KEY=

# Base URL override (optional). Defaults per engine:
#   groq -> https://api.groq.com/openai/v1   ollama -> http://127.0.0.1:11434
#   llamacpp -> http://127.0.0.1:8080        openai-compat -> http://127.0.0.1:8000/v1
BAZABOT_BASE_URL=

# Generation + loop tuning (optional; shown with defaults).
BAZABOT_TEMPERATURE=0.3
BAZABOT_MAX_TOKENS=600
BAZABOT_MAX_STEPS=3
BAZABOT_TIMEOUT_MS=30000
BAZABOT_RATE_LIMIT=30

# Let the model drive EXTRA tool calls on top of deterministic intent routing.
# Fine to keep on for capable hosted models (Llama 3.x, Qwen). Turn off for very
# small local models that pick tools unreliably.
BAZABOT_MODEL_TOOL_LOOP=true

# Semantic knowledge search. Off by default: Groq has no embeddings API and the
# keyword search is strong. To enable, use an engine/provider that embeds and set
# BAZABOT_EMBEDDING_MODEL.
BAZABOT_SEMANTIC_SEARCH=false
BAZABOT_EMBEDDING_MODEL=

# Force the AI model for ALL languages including Kinyarwanda. Off by default:
# the AI handles English, French and Swahili well, but no free hosted model
# reliably produces Kinyarwanda (they drift to Swahili), so Kinyarwanda turns use
# the curated rule engine with real Kinyarwanda answers. Turn this on only once
# your model genuinely handles Kinyarwanda.
BAZABOT_AI_ALL_LANGS=false

# Shared store for memory + analytics across multiple instances / serverless
# functions. Strongly recommended on Vercel (in-process state doesn't persist
# between invocations). To enable: `npm i ioredis` and set a Redis URL.
BAZABOT_REDIS_URL=

# Protect GET /api/bazabot/analytics with a bearer token (optional).
BAZABOT_ANALYTICS_TOKEN=

# Verbose server-side agent logging.
BAZABOT_DEBUG=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=